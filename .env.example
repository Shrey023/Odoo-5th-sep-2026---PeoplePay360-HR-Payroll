# Copy to .env and fill values. Never commit .env.
# Free LLM provider keys - collect the ones you need.

# Groq - free fast inference. https://console.groq.com/keys
GROQ_API_KEY=

# Gemini - free, 1M context. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cerebras - free, very fast. https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Mistral - free codestral. https://console.mistral.ai
MISTRAL_API_KEY=

# OpenRouter - free model aggregator. https://openrouter.ai/keys
OPENROUTER_API_KEY=
